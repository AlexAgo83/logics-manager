#!/usr/bin/env sh
# Versioned pre-commit hook. Enable with: npm run setup-hooks
# Guards the clients/viewer/ -> logics_manager/viewer_assets/viewer/ sync so
# edits to the viewer source can never land out of sync with the served copy.

# Only run the check when viewer source or its packaged copy is staged.
if git diff --cached --name-only | grep -Eq '^(clients/viewer/|logics_manager/viewer_assets/viewer/)'; then
  if ! npm run --silent check:viewer-assets; then
    echo ""
    echo "✖ Commit blocked: clients/viewer/ and viewer_assets/viewer/ are out of sync."
    echo "  Run: npm run sync:viewer-assets   then re-stage and commit."
    exit 1
  fi
fi
exit 0
