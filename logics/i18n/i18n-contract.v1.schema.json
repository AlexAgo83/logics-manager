{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logics-manager.local/schemas/i18n-contract.v1.schema.json",
  "title": "Logics project i18n contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "applicability"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "applicability": { "enum": ["applicable", "not_applicable"] },
    "reason": { "type": "string", "minLength": 1 },
    "source_locale": { "$ref": "#/$defs/locale" },
    "default_locale": { "$ref": "#/$defs/locale" },
    "fallback_locale": { "$ref": "#/$defs/locale" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/locale" }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "pattern": "\\{locale\\}" } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "applicability": { "const": "applicable" } } },
      "then": { "required": ["source_locale", "default_locale", "fallback_locale", "locales", "catalog"] }
    },
    {
      "if": { "properties": { "applicability": { "const": "not_applicable" } } },
      "then": { "required": ["reason"] }
    }
  ],
  "$defs": {
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
  }
}
