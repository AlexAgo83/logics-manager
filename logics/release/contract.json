{
  "schema_version": "1.0",
  "project": {
    "id": "logics-manager",
    "display_name": "Logics Manager",
    "release_profile": "python-npm-vscode"
  },
  "version_sources": [
    {
      "path": "VERSION",
      "format": "plain_text",
      "required": true
    },
    {
      "path": "pyproject.toml",
      "format": "toml",
      "selector": "project.version",
      "required": true
    },
    {
      "path": "package.json",
      "format": "json",
      "selector": "version",
      "required": true
    },
    {
      "path": "README.md",
      "format": "plain_text",
      "selector": "badge.version",
      "required": true
    }
  ],
  "changelog": {
    "required": true,
    "version_heading_required": true,
    "paths": [
      {
        "path": "changelogs/CHANGELOGS_{version_underscore}.md",
        "format": "markdown",
        "required": true
      }
    ]
  },
  "release_notes": {
    "required": false,
    "paths": []
  },
  "operator_intents": [
    {
      "utterance": "prepare release",
      "boundary": "Prepare metadata, changelog, and validation evidence only. Do not tag, push, publish, upload assets, or create a GitHub release unless the operator explicitly asks for those actions.",
      "publication_action": false
    },
    {
      "utterance": "commit and push, fix if CI is not green",
      "boundary": "Commit and push the prepared change first, then inspect the real remote CI run for that exact pushed commit before making fixes.",
      "publication_action": false
    },
    {
      "utterance": "publish release",
      "boundary": "Create or verify the release tag, publish the GitHub release, and verify required downstream registry or deployment evidence before calling the release complete.",
      "publication_action": true
    }
  ],
  "missing_contract_discovery": {
    "draft_path": {
      "path": "logics/release/contract.draft.json",
      "format": "json",
      "required": false
    },
    "local_first": true,
    "neighbor_projects_allowed": true,
    "local_sources": [
      {
        "path": "LOGICS.md",
        "required": false
      },
      {
        "path": "README.md",
        "required": false
      },
      {
        "path": "package.json",
        "required": false
      },
      {
        "path": "pyproject.toml",
        "required": false
      },
      {
        "path": ".github/workflows/",
        "required": false
      },
      {
        "path": "changelogs/",
        "required": false
      },
      {
        "path": "VERSION",
        "required": false
      },
      {
        "path": "checksums/",
        "required": false
      }
    ],
    "assistant_rule": "When a project has no active release contract, infer a draft from local sources first. Use neighboring projects only as comparison evidence after local release surfaces have been inspected."
  },
  "state_machine": [
    "planning",
    "preparing",
    "local_validation",
    "commit_ready",
    "pushed",
    "ci_verification",
    "github_release",
    "external_publication",
    "ready",
    "blocked"
  ],
  "gates": [
    {
      "id": "version_metadata",
      "state": "preparing",
      "required": true,
      "evidence_kinds": [
        "file"
      ],
      "comparison": "release"
    },
    {
      "id": "changelog",
      "state": "preparing",
      "required": true,
      "evidence_kinds": [
        "file"
      ],
      "comparison": "release"
    },
    {
      "id": "local_validation",
      "state": "local_validation",
      "required": true,
      "evidence_kinds": [
        "command"
      ],
      "comparison": "release"
    },
    {
      "id": "git_push",
      "state": "pushed",
      "required": true,
      "evidence_kinds": [
        "git"
      ],
      "comparison": "branch",
      "comparison_reason": "A push claim describes this branch's HEAD, not the tagged release commit."
    },
    {
      "id": "ci",
      "state": "ci_verification",
      "required": true,
      "evidence_kinds": [
        "ci"
      ],
      "comparison": "release"
    },
    {
      "id": "github_release",
      "state": "github_release",
      "required": true,
      "evidence_kinds": [
        "github_release"
      ],
      "comparison": "release"
    },
    {
      "id": "npm_publication",
      "state": "external_publication",
      "required": false,
      "evidence_kinds": [
        "external"
      ],
      "comparison": "release"
    }
  ],
  "evidence": {
    "store": {
      "path": "logics/release/evidence.jsonl",
      "format": "jsonl",
      "required": true
    },
    "freshness": {
      "match_target_version": true,
      "match_commit_for_source_gates": true,
      "match_tag_for_publication_gates": true
    },
    "required_fields": [
      "kind",
      "status",
      "observed_at",
      "target_version",
      "commit",
      "summary"
    ]
  },
  "validation_commands": [
    {
      "id": "ci_check",
      "command": [
        "node",
        "scripts/ci-check.mjs"
      ],
      "required": true,
      "evidence_kind": "command"
    }
  ],
  "git": {
    "release_branch_policy": "main_only",
    "allowed_branches": [
      "main"
    ],
    "tag_policy": {
      "required": true,
      "pattern": "v{version}"
    },
    "require_clean_worktree": true,
    "require_pushed_commit": true
  },
  "github_release": {
    "required": true,
    "mode": "gh_cli",
    "draft_allowed": false,
    "asset_paths": []
  },
  "external_publication": [
    {
      "id": "npm_package",
      "kind": "package_registry",
      "required": false,
      "url_template": "https://www.npmjs.com/package/@grifhinz/logics-manager/v/{version}"
    },
    {
      "id": "pypi_package",
      "kind": "package_registry",
      "required": false,
      "url_template": "https://pypi.org/project/logics-manager/{version}/"
    },
    {
      "id": "vscode_marketplace",
      "kind": "package_registry",
      "required": false,
      "url_template": "https://marketplace.visualstudio.com/items?itemName=cdx-logics.logics-manager"
    }
  ],
  "assistant_readiness": {
    "must_inspect_status_before_claiming_ready": true,
    "readiness_source": "project_owned_evidence",
    "publication_requires_explicit_operator_approval": true
  }
}
