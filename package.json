{
  "name": "@grifhinz/logics-manager",
  "displayName": "Logics Orchestrator",
  "description": "Visual orchestration for Logics workflows inside VS Code.",
  "version": "2.22.0",
  "publisher": "cdx-logics",
  "icon": "clients/shared-web/media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexAgo83/logics-manager.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "logics-manager": "scripts/npm/logics-manager.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "VERSION",
    "pyproject.toml",
    "scripts/logics-manager.py",
    "scripts/npm/",
    "clients/shared-web/media/",
    "clients/viewer/index.html",
    "clients/viewer/browser-host.js",
    "clients/viewer/browser-host.js.map",
    "clients/viewer/viewer.css",
    "dist/vendor/mermaid.min.js",
    "logics_manager/*.py",
    "logics_manager/**/*.py",
    "logics_manager/statuses.json",
    "logics_manager/skill_assets/"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "logics",
          "title": "Logics",
          "icon": "clients/shared-web/media/logics.svg"
        }
      ]
    },
    "views": {
      "logics": [
        {
          "id": "logics.orchestrator",
          "name": "Orchestrator",
          "icon": "clients/shared-web/media/logics.svg",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "logics.refresh",
        "title": "Logics: Refresh"
      },
      {
        "command": "logics.checkEnvironment",
        "title": "Logics: Check Environment"
      },
      {
        "command": "logics.openViewer",
        "title": "Logics: Open Viewer"
      },
      {
        "command": "logics.restartViewer",
        "title": "Logics: Restart Viewer"
      },
      {
        "command": "logics.openViewerExternal",
        "title": "Logics: Open Viewer Externally"
      },
      {
        "command": "logics.focusCurrent",
        "title": "Logics: Focus Current Item"
      }
    ]
  },
  "scripts": {
    "view": "node scripts/dev/run-viewer.mjs",
    "view:lan-rw": "node scripts/dev/run-viewer.mjs --lan --lan-rw",
    "clean:local-artifacts": "node scripts/dev/clean-local-artifacts.mjs",
    "bundle:viewer-host": "node scripts/build/build-viewer-browser-host.mjs",
    "check:viewer-host": "node scripts/build/build-viewer-browser-host.mjs --check",
    "build:assets": "node scripts/build/build-assets.mjs",
    "build:changelog": "node scripts/build/build-changelog.mjs",
    "check:changelog": "node scripts/build/build-changelog.mjs --check",
    "check:line-budget": "node scripts/check-source-line-budget.mjs",
    "check:function-length": "node scripts/run-python.mjs scripts/check_function_length.py",
    "generate:status-constants": "node scripts/build/generate-status-constants.mjs",
    "check:status-constants": "node scripts/build/generate-status-constants.mjs --check",
    "prepare": "node scripts/dev/clear-retired-hooks-path.mjs || true",
    "bundle:extension": "node scripts/build/package-extension.mjs",
    "watch:bundle": "node scripts/build/package-extension.mjs --watch",
    "watch:types": "tsc -watch -p ./",
    "compile": "tsc -p ./ && npm run bundle:extension",
    "watch": "npm run watch:bundle",
    "test": "vitest run",
    "test:coverage:src": "node scripts/run-plugin-coverage.mjs src",
    "test:coverage:media": "node scripts/run-plugin-coverage.mjs media",
    "test:coverage": "npm run test:coverage:src && npm run test:coverage:media",
    "test:smoke": "node tests/run_extension_smoke_checks.mjs",
    "test:viewer-smoke": "node tests/run_local_viewer_visual_smoke.mjs",
    "test:npm-cli": "node scripts/npm/logics-manager.mjs --help",
    "test:lifecycle": "node tests/run_plugin_lifecycle_checks.mjs",
    "test:watch": "vitest",
    "lint": "npm run lint:ts && npm run lint:es && npm run check:line-budget && npm run check:function-length && npm run check:status-constants",
    "lint:ts": "tsc -p ./ --noEmit",
    "lint:es": "eslint clients/vscode/src/**/*.ts",
    "lint:logics": "node scripts/run-python.mjs -m logics_manager lint",
    "audit:logics": "node scripts/run-python.mjs -m logics_manager audit && node scripts/run-python.mjs -m logics_manager lint",
    "audit:logics:strict": "node scripts/run-python.mjs -m logics_manager audit --governance-profile strict && node scripts/run-python.mjs -m logics_manager lint --require-status",
    "audit:ci": "node scripts/check-npm-audit.mjs",
    "docs:check": "node scripts/check-readme-badges.mjs",
    "logics:finish:task": "node scripts/run-python.mjs -m logics_manager flow finish task",
    "logics:scaffold": "node scripts/logics-scaffold.mjs",
    "ci:fast": "npm run compile && npm run lint && npm run test:coverage && npm run test:smoke && npm run lint:logics && npm run check:artifacts && npm run package:ci",
    "ci:check": "node scripts/ci-check.mjs",
    "dev": "npm run compile && code --extensionDevelopmentPath=.",
    "test:vscode": "npm run bundle:viewer-host && npm run build:assets && npm run compile && open -na 'Visual Studio Code' --args --extensionDevelopmentPath=\"$PWD\" \"$PWD\"",
    "debug:webview": "node clients/viewer/debug-webview/server.mjs",
    "package:ci": "node scripts/build/package-ci.mjs",
    "package": "npm run compile && node scripts/build/package-release.mjs",
    "package:npm": "node scripts/build/package-npm.mjs",
    "install:vsix": "npm run package && node scripts/build/install-vsix.mjs",
    "publish:npm": "node scripts/release/publish-npm.mjs",
    "release:changelog:resolve": "node scripts/release/resolve-release-changelog.mjs --validate-current",
    "release:changelog:validate": "node scripts/release/resolve-release-changelog.mjs --validate-current --require-curated",
    "check:artifacts": "node scripts/check-artifact-contents.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "jsdom": "^25.0.1",
    "mermaid": "^11.14.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2",
    "ws": "8.21.0",
    "yaml": "^2.8.3",
    "yauzl": "^3.2.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "dompurify": "3.4.13",
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    },
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "qs": "6.15.2",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}
